# Copy this file to `.env` and fill in real values. Never commit `.env`.

# --- Model service (OpenAI-compatible /chat/completions) ---
VENUS_API_KEY=sk-your-key-here
VENUS_BASE_URL=https://api.example.com/v1
VENUS_MODEL=your-model-name

# --- QQ official bot (optional) ---
# AppID/AppSecret can also come from the QR onboarding flow, which stores
# them in data/qq-credentials.json (gitignored).
QQ_APP_ID=
QQ_APP_SECRET=
# Comma-separated openid allowlist. Leave empty to use local pairing approval.
QQ_ALLOWED_OPENIDS=

# --- Optional path overrides ---
# QQ_PAIRING_DB=data/pairing.sqlite3
# QQ_CREDENTIALS_FILE=data/qq-credentials.json
